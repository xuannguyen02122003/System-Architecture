# Copy this file to  backend/.env  and fill in your key to use a REAL LLM.
# Without a key, the app runs on the deterministic stub (no network needed).

# Your OpenAI (or OpenAI-compatible) API key:
OPENAI_API_KEY=

# The API base URL. Leave as-is for OpenAI. Point it elsewhere for Azure OpenAI,
# a local server (Ollama/LM Studio), or any OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# The model to use:
LLM_MODEL=gpt-4o-mini

# Optional: milliseconds to pace each trace step in the live stream (for demo
# visibility). Default 250. Set to 0 to stream as fast as possible.
# SSE_STEP_DELAY_MS=250
